# Core application
APP_NAME='Network Event Management' # Dashboard title.
APP_ENV=development # Set production to enable stricter startup checks.
APP_URL=http://localhost:8000 # Public dashboard URL used by Telegram buttons.
BIND_HOST=127.0.0.1 # Host interface published by Compose; localhost is the safe default.
DASHBOARD_PORT=8000 # Host port for the dashboard.
DATABASE_PATH=./data/monitor.db # Local-run SQLite path; Compose overrides this.
LOG_LEVEL=INFO # DEBUG, INFO, WARNING, ERROR, or CRITICAL.
JSON_LOGS=false # Emit structured JSON logs when true.
RAW_LOG_MAX_LENGTH=4096 # Maximum hostile raw-log characters retained.

# Phase 5 storage (real passwords belong only in .env)
POSTGRES_DB=networksec # PostgreSQL database name.
POSTGRES_USER=networksec # Dedicated application role.
POSTGRES_PASSWORD= # Required by Compose; generate a unique value locally.
POSTGRES_BIND_HOST=127.0.0.1 # Keep PostgreSQL off public interfaces.
POSTGRES_PORT=5432 # Loopback port used by explicit integration tests.
POSTGRES_DSN= # Local Python DSN; Compose constructs an internal DSN from values above.
POSTGRES_MIGRATIONS_PATH=./migrations/postgresql # Ordered SQL migration directory.
POSTGRES_CONNECT_TIMEOUT_SECONDS=5 # Fail fast when state storage is unavailable.
LOKI_URL=http://127.0.0.1:3100 # Compose overrides this with the service DNS name.
LOKI_BIND_HOST=127.0.0.1 # Loki has no built-in authentication; never expose publicly.
LOKI_PORT=3100 # Loopback port used by explicit integration tests.
LOKI_TIMEOUT_SECONDS=5 # HTTP push/query timeout.
PROCESSOR_SPOOL_PATH=./data/processor.jsonl # Local path; Compose reads the rsyslog volume.
PROCESSOR_STATE_PATH=./data/processor-state.db # Checkpoint, health and dead-letter state.
CORRELATION_DATABASE_PATH=./data/correlation.db # Replay-safe aggregate/trace state.
CORRELATION_RULES_PATH=./config/correlation_rules.yaml # Versioned aggregation rules.
PROCESSOR_SOURCE_TIMEZONE=UTC # Timezone for vendor timestamps without an offset.
PROCESSOR_POLL_INTERVAL_SECONDS=0.25 # Idle spool polling interval.
PROCESSOR_RETRY_INTERVAL_SECONDS=2 # Delay after correlation/storage failures.
PROCESSOR_HEALTH_MAX_AGE_SECONDS=30 # Maximum heartbeat age.
GRAFANA_ADMIN_USER=admin # Local Grafana administrator name.
GRAFANA_ADMIN_PASSWORD= # Required locally; generate a unique password and never commit it.
GRAFANA_BIND_HOST=127.0.0.1 # Keep Grafana on the management loopback interface.
GRAFANA_PORT=3000 # Local operational dashboard port.
DASHBOARD_BACKEND=legacy # Use operational with configured Loki/PostgreSQL.

# Phase 2 Syslog collection (container listens on 5514 internally)
SYSLOG_BIND_HOST=127.0.0.1 # Set the Ubuntu VM interface explicitly for GNS3 sources.
SYSLOG_TCP_PORT=5514 # Published TCP port.
SYSLOG_UDP_PORT=5514 # Published UDP port.
RSYSLOG_MAX_MESSAGE_KB=32 # Maximum accepted message size; generator enforces the same default.
RSYSLOG_QUEUE_SIZE=10000 # In-memory message slots before backpressure/disk assistance.
RSYSLOG_QUEUE_HIGH_WATERMARK=8000 # Start disk-assisted mode above this count.
RSYSLOG_QUEUE_LOW_WATERMARK=2000 # Return from disk-assisted mode below this count.
RSYSLOG_QUEUE_DISK_MB=256 # Maximum durable queue size on the named volume.
RSYSLOG_QUEUE_WORKERS=1 # Keep low on the 2-vCPU VM.
RSYSLOG_QUEUE_CHECKPOINT_INTERVAL=100 # Persist queue progress every N messages.
RSYSLOG_RETRY_SECONDS=2 # Delay before retrying a suspended output action.
SYSLOG_PROTOCOL=tcp # tcp is preferred; udp is best-effort.
SYSLOG_EVENT_RATE=10 # Events per second; zero disables pacing.
SYSLOG_EVENT_COUNT=100 # Generated/replayed records; zero means all lines for Loghub replay.
SYSLOG_SEND_RETRIES=3 # Generator socket retry count.
SYSLOG_RETRY_DELAY_SECONDS=0.5 # Generator delay between retry attempts.

# Dashboard authentication (required for local use; keep real values only in .env)
ADMIN_USERNAME=admin # Dashboard login name.
ADMIN_PASSWORD_HASH= # Generate with: python -m app.password_hash
SESSION_SECRET= # Fill locally with at least 32 random bytes before starting the app.
SESSION_HTTPS_ONLY=false # Use true behind HTTPS.
DEVICE_SILENT_MINUTES=15 # Minutes without telemetry before a synthetic alert.

# Telegram (leave token/IDs empty to disable local in-process notifications)
TELEGRAM_BOT_TOKEN= # BotFather token; never commit a populated value.
ALLOWED_CHAT_IDS= # Comma-separated private analyst chat IDs; do not use a shared group.
TELEGRAM_MIN_SEVERITY=medium # Lowest severity sent to Telegram.
TELEGRAM_TIMEZONE=Asia/Ho_Chi_Minh # IANA timezone used in notification timestamps.
NOTIFICATION_INTERVAL_SECONDS=2 # Seconds between outbox polls.
DEDUP_WINDOW_SECONDS=60 # Aggregation window for identical dedup keys.
MAX_MESSAGES_PER_MINUTE=20 # Global individual-message limit.
TELEGRAM_RATE_WINDOW_SECONDS=60 # Rate-limit accounting window.

# Realistic mock source and demo scenario defaults
MOCK_MODE=true # Legacy dashboard demo-mode indicator.
MOCK_GENERATION_MODE=replay # replay, random, or scenario.
MOCK_FIXTURE_PATH=./fixtures/alerts.json # Canonical fixture bundle.
MOCK_RATE_PER_SECOND=0 # Zero emits immediately; positive values pace replay.
MOCK_DURATION_SECONDS=60 # Simulated scenario event window.
MOCK_SCENARIO= # Optional named scenario, e.g. ssh_bruteforce.
MOCK_SEVERITY_DISTRIBUTION=low=40,medium=35,high=20,critical=5 # Random-mode weights.
POLL_INTERVAL_SECONDS=10 # Legacy silent-device watcher interval.
SCENARIO_NAME=ssh_bruteforce # Make/Compose scenario default.
SCENARIO_DURATION=60 # Make/Compose scenario duration.

# Config paths for local runs; Compose uses immutable container paths
SEVERITY_CONFIG=./config/severity_map.yaml # Editable numeric rule-level mapping.
RULES_CATALOG=./config/rules_catalog.yaml # Detection use-case catalog.
