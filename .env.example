# Application
APP_NAME='Network Security Monitor'
APP_ENV=development
APP_URL=http://localhost:8000
DATABASE_PATH=./data/monitor.db
LOG_LEVEL=INFO
MOCK_MODE=true

# Dashboard login. Demo password: change-me-now (replace before sharing/deploying).
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH='pbkdf2_sha256$390000$u2WxtrZ7pUVy0YkO7G-Stw$FOwvcTDyIb3bFK8r4YLluNYx0lY84fqUy5t7WaVSWtY'
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_HTTPS_ONLY=false
DEVICE_SILENT_MINUTES=15

# Wazuh Indexer / OpenSearch
WAZUH_INDEXER_URL=https://wazuh-indexer:9200
WAZUH_INDEX_PATTERN=wazuh-alerts-*
WAZUH_USERNAME=
WAZUH_PASSWORD=
WAZUH_VERIFY_TLS=true
WAZUH_CA_FILE=
WAZUH_INITIAL_LOOKBACK_MINUTES=5
POLL_INTERVAL_SECONDS=10

# Telegram (leave blank to disable)
TELEGRAM_BOT_TOKEN=
ALLOWED_CHAT_IDS=
MINIMUM_SEVERITY=medium
NOTIFICATION_INTERVAL_SECONDS=2
DEDUP_WINDOW_SECONDS=60
TELEGRAM_RATE_LIMIT=20
TELEGRAM_RATE_WINDOW_SECONDS=60

# Config paths inside the container
SEVERITY_CONFIG=./config/severity.yaml
RULES_CATALOG=./config/rules_catalog.yaml
