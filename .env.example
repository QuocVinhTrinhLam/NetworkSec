# Core application
APP_NAME='Network Security Monitor' # Dashboard title.
APP_ENV=development # Set production to enable stricter startup checks.
APP_URL=http://localhost:8000 # Public dashboard URL used by Telegram buttons.
BIND_HOST=127.0.0.1 # Host interface published by Compose; localhost is the safe default.
DASHBOARD_PORT=8000 # Host port for the dashboard.
DATABASE_PATH=./data/monitor.db # Local-run SQLite path; Compose overrides this.
LOG_LEVEL=INFO # DEBUG, INFO, WARNING, ERROR, or CRITICAL.
JSON_LOGS=false # Emit structured JSON logs when true.
ALERT_SOURCE=mock # mock or wazuh; wazuh is an intentional Phase 2 stub.
RAW_LOG_MAX_LENGTH=4096 # Maximum hostile raw-log characters retained.

# Dashboard authentication (development example only; replace before sharing)
ADMIN_USERNAME=admin # Dashboard login name.
ADMIN_PASSWORD_HASH='pbkdf2_sha256$390000$u2WxtrZ7pUVy0YkO7G-Stw$FOwvcTDyIb3bFK8r4YLluNYx0lY84fqUy5t7WaVSWtY' # Demo password: change-me-now.
SESSION_SECRET=replace-with-at-least-32-random-characters # Cookie signing secret.
SESSION_HTTPS_ONLY=false # Use true behind HTTPS.
DEVICE_SILENT_MINUTES=15 # Minutes without telemetry before a synthetic alert.

# Telegram (leave token/IDs empty to disable local in-process notifications)
TELEGRAM_BOT_TOKEN= # BotFather token; never commit a populated value.
ALLOWED_CHAT_IDS= # Comma-separated private analyst chat IDs; do not use a shared group.
TELEGRAM_MIN_SEVERITY=medium # Lowest severity sent to Telegram.
TELEGRAM_TIMEZONE=Asia/Ho_Chi_Minh # IANA timezone used in notification timestamps.
NOTIFICATION_INTERVAL_SECONDS=2 # Seconds between outbox polls.
DEDUP_WINDOW_SECONDS=60 # Aggregation window for identical dedup keys.
MAX_MESSAGES_PER_MINUTE=20 # Global individual-message limit.
TELEGRAM_RATE_WINDOW_SECONDS=60 # Rate-limit accounting window.

# Realistic mock source and demo scenario defaults
MOCK_MODE=true # Legacy dashboard demo-mode indicator.
MOCK_GENERATION_MODE=replay # replay, random, or scenario.
MOCK_FIXTURE_PATH=./fixtures/alerts.json # Canonical fixture bundle.
MOCK_RATE_PER_SECOND=0 # Zero emits immediately; positive values pace replay.
MOCK_DURATION_SECONDS=60 # Simulated scenario event window.
MOCK_SCENARIO= # Optional named scenario, e.g. ssh_bruteforce.
MOCK_SEVERITY_DISTRIBUTION=low=40,medium=35,high=20,critical=5 # Random-mode weights.
SCENARIO_NAME=ssh_bruteforce # Make/Compose scenario default.
SCENARIO_DURATION=60 # Make/Compose scenario duration.

# Wazuh Indexer / OpenSearch (Phase 2 adapter settings)
WAZUH_INDEXER_URL=https://wazuh-indexer:9200 # Reachable URL of the separate Wazuh VM.
WAZUH_INDEX_PATTERN=wazuh-alerts-* # Index glob planned for search_after queries.
WAZUH_USERNAME= # Read-only Indexer account.
WAZUH_PASSWORD= # Read-only Indexer password.
WAZUH_VERIFY_TLS=true # Keep certificate verification enabled.
WAZUH_CA_FILE= # Container path to a mounted private CA bundle.
WAZUH_INITIAL_LOOKBACK_MINUTES=5 # Initial query lookback after startup.
POLL_INTERVAL_SECONDS=10 # Source poll interval.

# Config paths for local runs; Compose uses immutable container paths
SEVERITY_CONFIG=./config/severity_map.yaml # Editable Wazuh level mapping.
RULES_CATALOG=./config/rules_catalog.yaml # Detection use-case catalog.
